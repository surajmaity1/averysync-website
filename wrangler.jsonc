{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "staging-averysync-website",
  "compatibility_date": "2025-12-24",
  "assets": {
    "directory": "./dist",
		"not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  }
}
